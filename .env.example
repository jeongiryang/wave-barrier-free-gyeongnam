# 필수: 공공데이터포털에서 발급받은 일반 인증키(Encoded)
TOUR_API_SERVICE_KEY_ENCODED=
# 선택: 승인된 경남 지자체 쓰레기통 JSON API의 HTTPS 주소와 화면용 데이터셋 이름
WASTE_BIN_API_URL=
WASTE_BIN_API_SOURCE=

# 필수: 카카오 지도 JavaScript 키와 카카오 REST API 키
KAKAO_MAP_JAVASCRIPT_KEY=
KAKAO_REST_API_KEY=

# 선택: 별도 키를 발급받은 경우에만 입력
KORAIL_API_KEY=
TAGO_API_KEY=
ODSAY_API_KEY=
EXPRESSWAY_API_KEY=

# 선택: 경남 여성용품 비치 장소 공식 통합 OpenAPI HTTPS 주소(서버 전용)
SANITARY_SUPPLY_API_URL=

# Neon Postgres: 공유 일정과 사용자 제보 등 서비스 자체 데이터만 저장
DATABASE_URL=

# Neon Auth: Neon Console의 Auth 화면에서 발급
NEON_AUTH_BASE_URL=
# 32자 이상의 무작위 문자열. `openssl rand -base64 32` 등으로 생성
NEON_AUTH_COOKIE_SECRET=

# Vercel Production Cron 인증용. Production에서는 프로젝트 환경 변수로 32자 이상 설정
CRON_SECRET=

# 선택: 커뮤니티 신고를 처리할 Neon Auth 사용자 ID를 쉼표로 구분
COMMUNITY_MODERATOR_USER_IDS=

# 선택: WAVE 나루의 자체 운영 로컬 LLM. 브라우저에 노출하지 않는 서버 전용 값.
# 인터넷 연결은 HTTPS 인증 게이트웨이만 사용. Ollama 포트 자체를 공개하지 않습니다.
WAVE_AI_BASE_URL=
WAVE_AI_MODEL=gemma4:26b
WAVE_AI_TOKEN=
# 선택: 주 서버 통신 실패 시 한 번 시도할 별도 무료 로컬 모델. 서버 전용.
WAVE_AI_FALLBACK_BASE_URL=
WAVE_AI_FALLBACK_MODEL=
WAVE_AI_FALLBACK_TOKEN=
