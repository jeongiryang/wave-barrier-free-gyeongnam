# 필수: 공공데이터포털에서 발급받은 일반 인증키(Encoded)
TOUR_API_SERVICE_KEY_ENCODED=

# 필수: 카카오 지도 JavaScript 키와 카카오 REST API 키
KAKAO_MAP_JAVASCRIPT_KEY=
KAKAO_REST_API_KEY=

# 선택: 별도 키를 발급받은 경우에만 입력
KORAIL_API_KEY=
TAGO_API_KEY=
ODSAY_API_KEY=
EXPRESSWAY_API_KEY=

# Neon Postgres: 공유 일정과 사용자 제보 등 서비스 자체 데이터만 저장
DATABASE_URL=

# Neon Auth: Neon Console의 Auth 화면에서 발급
NEON_AUTH_BASE_URL=
# 32자 이상의 무작위 문자열. `openssl rand -base64 32` 등으로 생성
NEON_AUTH_COOKIE_SECRET=
